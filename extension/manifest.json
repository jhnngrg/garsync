{
  "manifest_version": 3,
  "name": "GarSync – Send Mapy.com routes to Garmin",
  "short_name": "GarSync",
  "version": "1.0.2",
  "description": "Send a route from Mapy.com to Garmin Connect and your Garmin watch or bike computer in one click. Unofficial add-on.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GarSync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://mapy.com/*",
    "https://*.mapy.com/*",
    "https://mapy.cz/*",
    "https://*.mapy.cz/*",
    "https://connect.garmin.com/*",
    "https://sso.garmin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mapy.com/*",
        "https://*.mapy.com/*",
        "https://mapy.cz/*",
        "https://*.mapy.cz/*"
      ],
      "js": [
        "content/mapy-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mapy.com/*",
        "https://*.mapy.com/*",
        "https://mapy.cz/*",
        "https://*.mapy.cz/*"
      ],
      "js": [
        "lib/mapy-route.js",
        "lib/i18n.js",
        "lib/flags.js",
        "content/mapy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://connect.garmin.com/*"
      ],
      "js": [
        "lib/garmin-api.js",
        "content/garmin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
